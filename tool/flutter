#!/usr/bin/env bash
set -euo pipefail
TAROT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
export PUB_CACHE="$TAROT_ROOT/.tooling/pub-cache"
export FLUTTER_SUPPRESS_ANALYTICS=true
if [[ -x "$TAROT_ROOT/.tooling/flutter/bin/flutter" ]]; then
  exec "$TAROT_ROOT/.tooling/flutter/bin/flutter" "$@"
fi
exec flutter "$@"
